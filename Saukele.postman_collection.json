              "raw": "{\n  \"registryId\": {{registryId}},\n  \"title\": \"Tea Set\",\n  \"priceKzt\": 25000,\n  \"giftType\": \"SINGLE\",\n  \"category\": \"Home\",\n  \"isPrivate\": false\n}"
            }
          }
        },
        {
          "name": "Add PRIVATE Gift (tier 1-2 only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/gifts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registryId\": {{registryId}},\n  \"title\": \"Gold Jewelry (Private — ATA_ANA only)\",\n  \"priceKzt\": 150000,\n  \"giftType\": \"SINGLE\",\n  \"category\": \"Tradition\",\n  \"isPrivate\": true\n}"
            }
          }
        },
        {
          "name": "Add POOL Gift",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('poolGiftId',pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/gifts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registryId\": {{registryId}},\n  \"title\": \"Honeymoon Fund\",\n  \"priceKzt\": 50000,\n  \"giftType\": \"POOL\",\n  \"category\": \"Travel\",\n  \"isPrivate\": false\n}"
            }
          }
        },
        {
          "name": "Get Gift (with funding progress)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/gifts/{{singleGiftId}}"
          }
        },
        {
          "name": "Reserve SINGLE Gift (Guest)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/gifts/{{singleGiftId}}/reserve"
          }
        }
      ]
    },
    {
      "name": "Contributions",
      "item": [
        {
          "name": "Contribute to POOL Gift — KZT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r=pm.response.json();if(r.paymentRef)pm.collectionVariables.set('paymentRef',r.paymentRef);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/contributions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"giftId\": {{poolGiftId}},\n  \"amountKzt\": 25000,\n  \"originalCurrency\": \"KZT\",\n  \"amountOriginal\": 25000,\n  \"message\": \"Congratulations!\"\n}"
            }
          }
        },
        {
          "name": "Contribute to POOL Gift — EUR (snapshot)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r=pm.response.json();if(r.paymentRef)pm.collectionVariables.set('paymentRef',r.paymentRef);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/contributions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"giftId\": {{poolGiftId}},\n  \"amountKzt\": 25000,\n  \"originalCurrency\": \"EUR\",\n  \"amountOriginal\": 50,\n  \"message\": \"From Germany with love!\"\n}"
            }
          }
        },
        {
          "name": "Webhook — Payment SUCCESS",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret='docker-compose-webhook-secret';",
                  "const paymentRef=pm.collectionVariables.get('paymentRef');",
                  "const bodyStr=JSON.stringify({paymentRef:paymentRef,status:'SUCCESS'});",
                  "const sig=CryptoJS.HmacSHA256(bodyStr,secret).toString();",
                  "pm.request.headers.upsert({key:'x-saukele-signature',value:sig});",
                  "pm.request.body.update(bodyStr);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/contributions/webhook/payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentRef\": \"{{paymentRef}}\",\n  \"status\": \"SUCCESS\"\n}"
            }
          }
        }
      ]
    },
