  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Couple",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"couple@example.com\",\n  \"name\": \"Asel and Daniyar\",\n  \"password\": \"Password123\",\n  \"role\": \"COUPLE\"\n}"
            }
          }
        },
        {
          "name": "Register Guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest@example.com\",\n  \"name\": \"Bekzat Almas\",\n  \"password\": \"Password123\",\n  \"role\": \"GUEST\"\n}"
            }
          }
        },
        {
          "name": "Login Couple",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r=pm.response.json();pm.collectionVariables.set('coupleToken',r.accessToken);pm.collectionVariables.set('refreshToken',r.refreshToken);pm.collectionVariables.set('coupleId',r.userId||1);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"couple@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Login Guest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('guestToken',pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "403 — Guest tries Couple route",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/registries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"eventDate\": \"2026-08-01\"\n}"
            }
          }
        },
        {
          "name": "401 — No token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/registries"
          }
        }
      ]
    },
    {
      "name": "Registry",
      "item": [
        {
          "name": "Create Registry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r=pm.response.json();pm.collectionVariables.set('registryId',r.id);pm.collectionVariables.set('shareToken',r.shareToken);pm.collectionVariables.set('coupleId',r.coupleId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/registries",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Asel & Daniyar Wedding\",\n  \"eventDate\": \"2026-08-15\",\n  \"description\": \"Our beautiful wedding registry\"\n}"
            }
          }
        },
        {
          "name": "List Own Registries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/registries"
          }
        },
        {
          "name": "Publish Registry",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coupleToken}}"
              }
            ],
            "url": "{{baseUrl}}/registries/{{registryId}}/publish"
          }
        },
        {
          "name": "Public View by Share Token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/registries/share/{{shareToken}}"
          }
        }
      ]
    },
    {
