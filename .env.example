# Database
DATABASE_URL=postgresql://saukele:saukele_password@postgres:5432/saukele?schema=public

# Redis. Prefer REDIS_URL. REDIS_HOST/REDIS_PORT are fallback for Docker networks.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# JWT secrets must be unique 64+ character values in every environment.
JWT_SECRET=replace-with-at-least-64-characters-access-secret-000000000000000000
REFRESH_SECRET=replace-with-at-least-64-characters-refresh-secret-0000000000000000

# Payments
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret

# Backend runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost

# Email via Brevo. EMAIL_FROM must be a verified Brevo sender address/domain.
BREVO_API_KEY=replace-with-brevo-api-key
EMAIL_FROM=noreply@example.com

# Static frontend runtime config. Leave empty for same-domain /api proxy mode.
API_URL=
