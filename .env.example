# Database
DATABASE_URL=postgresql://saukele:saukele_password@postgres:5432/saukele?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (must be 64+ characters)
JWT_SECRET=replace-with-at-least-64-characters-access-secret-1234567890abcdef
REFRESH_SECRET=replace-with-at-least-64-characters-refresh-secret-1234567890abcde

# Payments
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost

# Email (Brevo)
BREVO_API_KEY=your-brevo-api-key-from-brevo.com
EMAIL_FROM=noreply@yourdomain.com
